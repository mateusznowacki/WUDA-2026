# Copy to .env and adjust values. Never commit the real .env file.

# --- Django ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=polls
POSTGRES_USER=polls
POSTGRES_PASSWORD=polls

# --- Gunicorn ---
GUNICORN_WORKERS=2
